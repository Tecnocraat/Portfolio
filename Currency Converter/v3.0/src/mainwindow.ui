  <property name="styleSheet">
   <string notr="true">/* Estilo para os Botões do Menu Superior */
QPushButton#btnConverter, QPushButton#btnDatabase, QPushButton#btnAbout {
    background-color: #f0f0f0;
    border: 1px solid #dcdcdc;
    border-radius: 5px;
    padding: 8px;
    font-weight: bold;
    color: #333;
}

QPushButton#btnConverter:hover, QPushButton#btnDatabase:hover, QPushButton#btnAbout:hover {
    background-color: #e5e5e5;
}

/* Estilo para o Botão &quot;Convert&quot; (Verde) */
QPushButton#btnConvert {
    background-color: #2ecc71;
    color: white;
    border-radius: 4px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#btnConvert:hover {
    background-color: #27ae60;
}

/* Estilo para os Campos de Entrada */
QLineEdit, QComboBox {
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 5px;
    background-color: white;
}

/* Estilo para as Tabelas (Database e About) */
QTableWidget {
    background-color: white;
    alternate-background-color: #f9f9f9;
    gridline-color: #f0f0f0;
    border: none;
    outline: 0;
}

QHeaderView::section {
    background-color: #f8f9fa;
    padding: 4px;
    border: 1px solid #e0e0e0;
    font-weight: bold;
}</string>
